{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "nextjs-app",
          "format": "url",
          "env": "NEXTJS_APP_URL"
        }
      ]
    },
    "nextjs-app": {
      "root": "nextjs-app",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "nextjs-app"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "nextjs-app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
